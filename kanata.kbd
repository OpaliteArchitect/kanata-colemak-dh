(defcfg
  ;; ** For Linux **
  ;; input  (device-file "/dev/input/by-id/usb-04d9_USB-HID_Keyboard-event-kbd")
  ;; output (uinput-sink "Kanata Colemak-DH output")

  ;; ** For Windows **
  ;; input  (low-level-hook)
  ;; output (send-event-sink)

  ;; ** For MacOS **
  ;; input  (iokit-name "my-keyboard-product-string")
  ;; output (kext)

  process-unmapped-keys   yes
  concurrent-tap-hold     yes
  allow-hardware-repeat   no
)

;; Source layer - defines which keys are intercepted
(defsrc
  esc     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12            ;; 13
  grv     1    2    3    4    5    6    7    8    9    0    -    =    bspc      ;; 14
  tab     q    w    e    r    t    y    u    i    o    p    [    ]    \         ;; 14
  caps    a    s    d    f    g    h    j    k    l    ;    '    ret            ;; 13
  lsft       z    x    c    v    b    n    m    ,    .    /    rsft             ;; 12
  lctl    lmet lalt           spc            ralt rmet menu rctl                ;; 8
)

;; Colemak Mod-DH main layer
(deflayer colemak-dh
  esc     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv      1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab      q    w    f    p    b    j    l    u    y    ;    [    ]    \
  @ext     a    r    s    t    g    m    n    e    i    o    '    ret
  lsft        x    c    d    v    z    k    h    ,    .    /    rsft
  lctl     lmet lalt           spc            ralt rmet _    _
)

;; Extend layer for navigation, function keys, and layer switching
;; Inspired by DreymaR's BigBag extend layer
(deflayer extend
  caps    pp   prev next _     mute vold volu media homepage _  _      _                   ;; 13
  _       f1   f2   f3   f4    f5   f6   f7   f8    f9   f10    f11    f12   pause         ;; 14
  lrld    esc  @mwu @bk  @fw   @cup pgup home up    end  del    C-y    ins   homepage      ;; 14
  _       lalt @mwd lsft lctl  @cdn pgdn lft  down  rght bspc   menu   prtsc               ;; 13
  _          C-x  C-c  mlft  C-v  C-z  mmid mrgt @clf  @crg   _      _                     ;; 12
  _       _    _                ret               _    _    _      _                       ;; 8
)

;; Aliases for cleaner layer definitions
(defalias
  ;; Extend layer toggle on Caps Lock
  ext  (layer-toggle extend)

  ;; Common shortcuts for Extend layer
  cpy  C-c   ;; Copy
  pst  C-v   ;; Paste
  cut  C-x   ;; Cut
  udo  C-z   ;; Undo
  all  C-a   ;; Select All
  bk   A-lft ;; Browser back
  fw   A-rght ;; Browser forward
  mwu (mwheel-accel-up      $initial-velocity $maximum-velocity $acceleration-multiplier $deceleration-multiplier)
  mwd (mwheel-accel-down    $initial-velocity $maximum-velocity $acceleration-multiplier $deceleration-multiplier)
  mwl (mwheel-accel-left    $initial-velocity $maximum-velocity $acceleration-multiplier $deceleration-multiplier)
  mwr (mwheel-accel-right   $initial-velocity $maximum-velocity $acceleration-multiplier $deceleration-multiplier)
  cup  (movemouse-accel-up    $m-interval $m-accel $m-min $m-max) ;; cursor up
  cdn  (movemouse-accel-down  $m-interval $m-accel $m-min $m-max) ;; cursor down
  clf  (movemouse-accel-left  $m-interval $m-accel $m-min $m-max) ;; cursor left
  crg  (movemouse-accel-right $m-interval $m-accel $m-min $m-max) ;; cursor right
  smul (setmouse 10000 10000)       ;; set mouse upper left
  smbr (setmouse 50000 50000)       ;; set mouse bottom right
)

(defvar
  m-interval 15
  m-accel 1000
  m-min 1
  m-max 120

  initial-velocity 20
  maximum-velocity 160
  acceleration-multiplier 1.10
  deceleration-multiplier 0.15
)
